          "type": "testimonial",
          "settings": {
            "title": "Collected in an hour",
            "description": "<p>\"Reserved a pizza oven online and it was ready when I arrived. Super easy and the staff even helped me load the car.\"</p>",
            "footer": "<p>Daniel R.</p>"
          }
        },
        "testimonial_3": {
          "type": "testimonial",
          "settings": {
            "title": "Fair price, great service",
