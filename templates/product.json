        "tab_2": {
          "type": "tab",
          "settings": {
            "header": "Delivery & Click & Collect",
            "content": "<p><strong>Free Click & Collect.</strong> Reserve online and collect from our store - usually ready within 2 hours of our confirmation email.</p><p><strong>Home delivery.</strong> We deliver large appliances to your door and can install them and remove your old appliance. Free delivery on orders over £150.</p>",
            "content_page": ""
          }
        },
        "tab_3": {
          "type": "tab",
          "settings": {
            "header": "Warranty & Returns",
            "content": "<p>Every product comes with the manufacturer's warranty, and our team will help you if you ever need to claim on it.</p><p>Changed your mind? Return unused items in their original packaging within 14 days for a refund.</p>",
            "content_page": ""
          }
        }
