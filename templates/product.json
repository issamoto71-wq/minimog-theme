    "faq": {
      "type": "hth-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Is this available to collect today?",
            "answer": "<p>Reserve it online with Click & Collect and we'll email you when it's ready - usually within 2 hours during opening times.</p>",
            "open": true
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Can you deliver and install it?",
            "answer": "<p>Yes. Delivery and installation can be arranged for most appliances, and we can recycle your old one. Call the store for a quote.</p>",
            "open": false
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "What warranty does it come with?",
            "answer": "<p>It comes with the manufacturer's warranty, plus help and advice from our team if you ever have a problem.</p>",
            "open": false
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Can I see it in the showroom first?",
            "answer": "<p>Many of our products are on display. Call ahead and we'll make sure it's out and ready for you to see.</p>",
            "open": false
          }
