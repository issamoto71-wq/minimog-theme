    "faq": {
      "type": "hth-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Can I see products in store before I buy?",
            "answer": "<p>Yes - most of our range is on display in the showroom, and our team can show you how things work. If there's something specific you'd like to see, give us a call and we'll have it ready for you.</p>",
            "open": true
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How does Click & Collect work?",
            "answer": "<p>Reserve your items online, wait for our confirmation email, then collect from the store during opening hours. Please bring your order confirmation and a form of ID.</p>",
            "open": false
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Do you deliver and install appliances?",
            "answer": "<p>We deliver large appliances to your door and can install them and take your old appliance away. Delivery charges and availability are confirmed at checkout.</p>",
            "open": false
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "What if I find it cheaper somewhere else?",
            "answer": "<p>Tell us - we're happy to look at matching a comparable local price on the same product. Speak to our team in store or on the phone.</p>",
            "open": false
          }
        },
        "question_5": {
          "type": "question",
