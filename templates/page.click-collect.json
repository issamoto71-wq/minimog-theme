          "type": "question",
          "settings": {
            "question": "How does Click & Collect work?",
            "answer": "<p>Reserve your items online, wait for our confirmation email, then collect from the store during opening hours. Please bring your order confirmation and a form of ID.</p>",
            "open": true
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Is this available to collect today?",
            "answer": "<p>Reserve it online with Click & Collect and we'll email you when it's ready - usually within 2 hours during opening times.</p>",
            "open": false
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "What if I find it cheaper somewhere else?",
            "answer": "<p>Tell us - we're happy to look at matching a comparable local price on the same product. Speak to our team in store or on the phone.</p>",
            "open": false
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "What warranty do products come with?",
            "answer": "<p>Every product comes with the manufacturer's warranty. If something goes wrong, bring it back to us and we'll help you get it sorted.</p>",
