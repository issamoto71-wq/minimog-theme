    "why_us": {
      "type": "hth-why-choose-us",
      "blocks": {
        "reason_1": {
          "type": "reason",
          "settings": {
            "icon": "users",
            "title": "Expert, friendly advice",
            "text": "Our team tests the products they sell and will help you pick the right one."
          }
        },
        "reason_2": {
          "type": "reason",
          "settings": {
            "icon": "tag",
            "title": "Fair, matched prices",
            "text": "Found it cheaper locally? Tell us and we'll do our best to match it."
          }
        },
        "reason_3": {
          "type": "reason",
          "settings": {
            "icon": "wrench",
            "title": "Delivery & installation",
            "text": "We can deliver, install and take your old appliance away."
          }
        },
        "reason_4": {
          "type": "reason",
          "settings": {
            "icon": "shield",
            "title": "Support after you buy",
            "text": "Warranty help and advice from the same people who sold it to you."
          }
        }
      },
