      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Do you deliver and install appliances?",
            "answer": "<p>We deliver large appliances to your door and can install them and take your old appliance away. Delivery charges and availability are confirmed at checkout.</p>",
            "open": true
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "What if I find it cheaper somewhere else?",
            "answer": "<p>Tell us - we're happy to look at matching a comparable local price on the same product. Speak to our team in store or on the phone.</p>",
            "open": false
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "What warranty do products come with?",
            "answer": "<p>Every product comes with the manufacturer's warranty. If something goes wrong, bring it back to us and we'll help you get it sorted.</p>",
            "open": false
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Can I return something I've changed my mind about?",
            "answer": "<p>Unused items in their original packaging can be returned for a refund within 14 days. Some items, such as made-to-order products, may be excluded - ask us if you're unsure.</p>",
            "open": false
          }
        }
      },
      "block_order": [
