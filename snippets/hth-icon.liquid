{% comment %}
  Hearth icon set - simple line icons that inherit the current text colour.

  Accepts:
  - name: {String} Icon key (required). See the icon list in any Hearth section's "Icon" setting.
  - size: {Number} Width/height in px. Default: 28 (optional)
  - stroke: {Number} Line weight. Default: 1.6 (optional)

  Usage:
  {% render 'hth-icon', name: 'truck', size: 32 %}
{% endcomment %}
{%- liquid
  assign icon_size = size | default: 28
  assign icon_stroke = stroke | default: 1.6
-%}
<svg
  class="hth-icon hth-icon--{{ name }}"
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="{{ icon_stroke }}"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'truck' -%}
      <path d="M3 6.5h11v9H3z"/><path d="M14 9.5h4l3 3.5v2.5h-7z"/><circle cx="7.5" cy="17.5" r="2"/><circle cx="17" cy="17.5" r="2"/>
    {%- when 'store' -%}
      <path d="M4 4h16l1.5 5.2H2.5z"/><path d="M4.5 9.2V20h15V9.2"/><path d="M10 20v-5h4v5"/>
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v5.5c0 4.6 3.1 8 7.5 9.5 4.4-1.5 7.5-4.9 7.5-9.5V6z"/><path d="m8.8 12 2.3 2.3 4.2-4.6"/>
    {%- when 'tag' -%}
      <path d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7l8.3 8.3a1.4 1.4 0 0 1 0 2l-6.7 6.7a1.4 1.4 0 0 1-2 0z"/><circle cx="8" cy="8" r="1.4"/>
    {%- when 'wrench' -%}
      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
    {%- when 'recycle' -%}
      <path d="M20 11a8 8 0 0 0-14.5-4.2L4 8.5"/><path d="M4 4v4.5h4.5"/><path d="M4 13a8 8 0 0 0 14.5 4.2l1.5-1.7"/><path d="M20 20v-4.5h-4.5"/>
    {%- when 'phone' -%}
      <path d="M5 4h3.5l1.5 4-2 1.3a11 11 0 0 0 5.7 5.7L15 13l4 1.5V18a2 2 0 0 1-2 2A13 13 0 0 1 3 6a2 2 0 0 1 2-2z"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>
    {%- when 'pin' -%}
      <path d="M12 21s-6.5-5.7-6.5-11a6.5 6.5 0 0 1 13 0c0 5.3-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.3 2"/>
    {%- when 'star' -%}
      <path d="m12 3.2 2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 17l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z"/>
    {%- when 'check' -%}
      <circle cx="12" cy="12" r="9"/><path d="m8 12.3 2.6 2.6L16 9.5"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="8" width="17" height="4" rx=".5"/><path d="M5 12v8h14v-8"/><path d="M12 8v12"/><path d="M12 8C10.8 4.5 7 4 7 6.5 7 8 9 8 12 8zm0 0c1.2-3.5 5-4 5-1.5C17 8 15 8 12 8z"/>
    {%- when 'card' -%}
      <rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19"/><path d="M6 15h4"/>
    {%- when 'chat' -%}
      <path d="M4 5h16v11H11l-4.5 4v-4H4z"/>
    {%- when 'users' -%}
      <circle cx="9" cy="8.5" r="3.2"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><circle cx="17" cy="9.5" r="2.5"/><path d="M17.5 14.6c2.3.3 3.8 2 3.8 4.4"/>
    {%- when 'award' -%}
      <circle cx="12" cy="9" r="5.5"/><path d="m9 14-1.2 7 4.2-2.4 4.2 2.4-1.2-7"/>
    {%- when 'box' -%}
      <path d="M12 3 3.5 7.5v9L12 21l8.5-4.5v-9z"/><path d="M3.5 7.5 12 12l8.5-4.5"/><path d="M12 12v9"/>
    {%- when 'thumbs-up' -%}
      <path d="M8 11v9H4.5v-9z"/><path d="M8 11 12 3.5c1.7 0 2.7 1.3 2.4 3L14 9h5a2 2 0 0 1 2 2.4l-1.2 6.5a2.5 2.5 0 0 1-2.4 2.1H8"/>
    {%- when 'flame' -%}
      <path d="M12 21c-3.9 0-6.5-2.7-6.5-6.2 0-3.4 2.4-5.2 3.5-8.3 1.9 1.1 3.2 2.7 3.5 4.7 1-.8 1.5-2 1.5-3.2 2.3 2 3.5 4.3 3.5 6.8 0 3.5-2.6 6.2-5.5 6.2z"/>
    {%- when 'utensils' -%}
      <path d="M7 3v7.5M4.5 3v5a2.5 2.5 0 0 0 5 0V3M7 11v10"/><path d="M17 21V3c-2.2 1.2-3.5 4-3.5 7.5H17"/>
    {%- when 'home' -%}
      <path d="M3.5 11 12 3.5l8.5 7.5"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-14 15-14 0 10-5 15-13 15"/><path d="M5 19c2-4 5-7 9-9"/>
    {%- when 'percent' -%}
      <path d="m19 5-14 14"/><circle cx="7" cy="7" r="2.5"/><circle cx="17" cy="17" r="2.5"/>
    {%- when 'calendar' -%}
      <rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17"/><path d="M8 3v4M16 3v4"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>
    {%- when 'return' -%}
      <path d="M9 5 4 9.5 9 14"/><path d="M4 9.5h10.5a5 5 0 0 1 0 10H9"/>
    {%- when 'coffee' -%}
      <path d="M4.5 9h12v6a5 5 0 0 1-5 5h-2a5 5 0 0 1-5-5z"/><path d="M16.5 10.5H18a2.5 2.5 0 0 1 0 5h-1.5"/><path d="M8 3.5c0 1.2 1.2 1.2 1.2 2.4M12 3.5c0 1.2 1.2 1.2 1.2 2.4"/>
    {%- when 'sparkle' -%}
      <path d="M12 3.5c.6 4.6 3.4 7.4 8 8-4.6.6-7.4 3.4-8 8-.6-4.6-3.4-7.4-8-8 4.6-.6 7.4-3.4 8-8z"/>
    {%- when 'arrow-right' -%}
      <path d="M4 12h15M13 6l6 6-6 6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/><path d="m8 12.3 2.6 2.6L16 9.5"/>
  {%- endcase -%}
</svg>
