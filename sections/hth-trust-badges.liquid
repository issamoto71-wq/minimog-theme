{%- liquid
  capture anim
    render 'hth-anim', section_animation: section.settings.animations
  endcapture
-%}
<section
  id="m-section--{{ section.id }}"
  class="m-section hth-section hth-trust hth-trust--{{ section.settings.style }} m-gradient m-color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --hth-cols: {{ section.settings.columns }};"
  data-section-id="{{ section.id }}"
>
  <div class="{{ section.settings.container }} m-section-py">
    {%- render 'hth-section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      alignment: section.settings.header_alignment,
      heading_size: section.settings.heading_size,
      anim: anim
    -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="hth-trust__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = 'div'
            if block.settings.link != blank
              assign tag = 'a'
            endif
          -%}
          <li
            class="hth-trust__item{{ anim }}"
            {% if anim != blank %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <{{ tag }}
              class="hth-trust__inner"
              {% if tag == 'a' %}
                href="{{ block.settings.link }}"
              {% endif %}
            >
              <span class="hth-trust__icon">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', width: 48, height: 48, alt: block.settings.title }}
                {%- else -%}
                  {%- render 'hth-icon', name: block.settings.icon, size: 30 -%}
                {%- endif -%}
              </span>
              <span class="hth-trust__text">
                {%- if block.settings.title != blank -%}
                  <strong class="hth-trust__title">{{ block.settings.title | escape }}</strong>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="hth-trust__desc">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </span>
            </{{ tag }}>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
