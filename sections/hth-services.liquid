{%- liquid
  capture anim
    render 'hth-anim', section_animation: section.settings.animations
  endcapture
-%}
<section
  id="m-section--{{ section.id }}"
  class="m-section hth-section hth-services hth-services--{{ section.settings.card_style }} m-gradient m-color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --hth-cols: {{ section.settings.columns }};"
  data-section-id="{{ section.id }}"
>
  <div class="{{ section.settings.container }} m-section-py">
    {%- render 'hth-section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      alignment: section.settings.header_alignment,
      heading_size: section.settings.heading_size,
      anim: anim
    -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="hth-services__list" role="list">
        {%- for block in section.blocks -%}
          <li
            class="hth-services__item{{ anim }}"
            {% if anim != blank %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              <div class="hth-services__media">
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 1024px) 25vw, 100vw', alt: block.settings.title, class: 'hth-services__img' }}
              </div>
            {%- endif -%}
            <div class="hth-services__body">
              <span class="hth-services__icon">{%- render 'hth-icon', name: block.settings.icon, size: 30 -%}</span>
              {%- if block.settings.title != blank -%}
                <h3 class="hth-services__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="hth-services__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
              {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                <a class="hth-link" href="{{ block.settings.link }}">
                  {{- block.settings.link_label | escape -}}
                  {%- render 'hth-icon', name: 'arrow-right', size: 16, stroke: 2 -%}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="hth-btn-row hth-btn-row--center{{ anim }}">
        <a class="m-button {{ section.settings.button_style }}" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
