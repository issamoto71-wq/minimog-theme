{%- liquid
  assign store_name = settings.store_name | default: shop.name
  assign year = 'now' | date: '%Y'
  assign copyright = section.settings.copyright | replace: '{year}', year | replace: '{store}', store_name
  assign perks = section.blocks | where: 'type', 'perk'
  assign phone = settings.contact_phone_number
  assign email = settings.contact_email
  assign show_follow_on_shop = false
  if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop
    assign show_follow_on_shop = true
  endif
-%}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_currency_selector or section.settings.show_country_selector or section.settings.show_language_selector -%}
  <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<footer class="hth-footer m-gradient m-color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  {%- if perks.size > 0 -%}
    <div class="hth-footer__perks m-gradient m-color-{{ section.settings.perks_color_scheme }}">
      <div class="{{ section.settings.container }}">
        <ul class="hth-footer__perks-list" role="list">
          {%- for block in perks -%}
            <li class="hth-footer__perk" {{ block.shopify_attributes }}>
              <span class="hth-footer__perk-icon">{%- render 'hth-icon', name: block.settings.icon, size: 30 -%}</span>
              <span class="hth-footer__perk-text">
                <strong>{{ block.settings.title | escape }}</strong>
                {%- if block.settings.text != blank -%}
                  <span>{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}

  <div class="hth-footer__main">
    <div class="{{ section.settings.container }}">
      <div class="hth-footer__grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'about' -%}
              <div class="hth-footer__block hth-footer__block--about hth-span-{{ block.settings.width }}" {{ block.shopify_attributes }}>
                {%- if block.settings.logo != blank -%}
                  <a class="hth-footer__logo" href="{{ routes.root_url }}">
                    {{ block.settings.logo | image_url: width: 480 | image_tag: loading: 'lazy', width: block.settings.logo_width, alt: store_name, style: 'max-width: 100%; height: auto;' }}
                  </a>
                {%- else -%}
                  <a class="hth-footer__logo hth-footer__logo--text" href="{{ routes.root_url }}">{{ store_name | escape }}</a>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="hth-footer__about-text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.show_contact -%}
                  <ul class="hth-footer__contact" role="list">
                    {%- if phone != blank -%}
                      <li>{%- render 'hth-icon', name: 'phone', size: 18 -%}<a href="tel:{{ phone | replace: ' ', '' }}">{{ phone | escape }}</a></li>
                    {%- endif -%}
                    {%- if email != blank -%}
                      <li>{%- render 'hth-icon', name: 'mail', size: 18 -%}<a href="mailto:{{ email }}">{{ email | escape }}</a></li>
                    {%- endif -%}
                  </ul>
                {%- endif -%}
                {%- if block.settings.show_social -%}
                  {%- render 'social-media-links', size: 'm-svg-icon--medium', extra_classes: 'hth-footer__social' -%}
                {%- endif -%}
              </div>

            {%- when 'menu' -%}
              {%- assign menu = linklists[block.settings.menu] -%}
              <nav class="hth-footer__block hth-footer__block--menu hth-span-{{ block.settings.width }}" aria-label="{{ block.settings.heading | default: menu.title | escape }}" {{ block.shopify_attributes }}>
                <h3 class="hth-footer__title">{{ block.settings.heading | default: menu.title | escape }}</h3>
                {%- if menu.links.size > 0 -%}
                  <ul class="hth-footer__links" role="list">
                    {%- for link in menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </nav>

            {%- when 'store' -%}
              {%- assign hours_lines = settings.store_opening_hours | newline_to_br | split: '<br />' -%}
              <div class="hth-footer__block hth-footer__block--store hth-span-{{ block.settings.width }}" {{ block.shopify_attributes }}>
                <h3 class="hth-footer__title">{{ block.settings.heading | escape }}</h3>
                {%- if block.settings.show_address and settings.store_address != blank -%}
                  <p class="hth-footer__address">
                    {%- render 'hth-icon', name: 'pin', size: 18 -%}
                    <span>{{ settings.store_address | escape | newline_to_br }}</span>
                  </p>
                {%- endif -%}
                {%- if block.settings.show_hours and settings.store_opening_hours != blank -%}
                  <table class="hth-hours hth-hours--footer" data-hth-hours>
                    <tbody>
                      {%- for line in hours_lines -%}
                        {%- assign parts = line | strip | split: '|' -%}
                        {%- if parts.size > 1 -%}
                          <tr data-day="{{ parts[0] | strip | downcase | escape }}">
                            <th scope="row">{{ parts[0] | strip | escape }}</th>
                            <td>{{ parts[1] | strip | escape }}</td>
                          </tr>
                        {%- endif -%}
                      {%- endfor -%}
                    </tbody>
                  </table>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  {%- liquid
                    assign directions_url = settings.store_directions_url
                    if directions_url == blank and settings.store_map_query != blank
                      assign encoded_query = settings.store_map_query | url_encode
                      assign directions_url = 'https://www.google.com/maps/search/?api=1&query=' | append: encoded_query
                    endif
                  -%}
                  {%- if directions_url != blank -%}
                    <a class="hth-footer__button m-button m-button--primary" href="{{ directions_url }}" target="_blank" rel="noopener">{{ block.settings.button_label | escape }}</a>
                  {%- endif -%}
                {%- endif -%}
              </div>

            {%- when 'newsletter' -%}
              <div class="hth-footer__block hth-footer__block--newsletter hth-span-{{ block.settings.width }}" {{ block.shopify_attributes }}>
                <h3 class="hth-footer__title">{{ block.settings.heading | escape }}</h3>
                {%- if block.settings.text != blank -%}
                  <p class="hth-footer__newsletter-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
                {%- render 'newsletter-form',
                  custom_id: block.id,
                  style: 'bordered',
                  button_type: 'text',
                  button_label: block.settings.button_label,
                  placeholder: block.settings.placeholder,
                  show_agreement: false,
                  has_icon: false,
                  button_position: 'inline',
                  button_style: 'm-button--primary'
                -%}
              </div>

            {%- when 'text' -%}
              <div class="hth-footer__block hth-footer__block--text hth-span-{{ block.settings.width }}" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h3 class="hth-footer__title">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                <div class="hth-footer__richtext rte">{{ block.settings.text }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="hth-footer__bottom m-gradient m-color-{{ section.settings.bottom_color_scheme }}">
    <div class="{{ section.settings.container }}">
      <div class="hth-footer__bottom-inner">
        <div class="hth-footer__bottom-left">
          {%- if copyright != blank -%}
            <span class="hth-footer__copyright">{{ copyright }}</span>
          {%- endif -%}
          {%- if section.settings.footer_bottom_menu != blank -%}
            <ul class="hth-footer__legal" role="list">
              {%- for link in linklists[section.settings.footer_bottom_menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
        <div class="hth-footer__bottom-right">
          {%- if section.settings.show_country_selector or section.settings.show_currency_selector or section.settings.show_language_selector -%}
            <div class="hth-footer__localization">
              {%- liquid
                if section.settings.show_country_selector
                  render 'country-selector', pos: 'top'
                endif
                if section.settings.show_currency_selector
                  render 'currency-switcher', pos: 'top'
                endif
                if section.settings.show_language_selector
                  render 'language-switcher', pos: 'top'
                endif
              -%}
            </div>
          {%- endif -%}
          {%- if show_follow_on_shop -%}
            <div class="m-follow-on-shop">
              {% # theme-check-disable %}
              {{ shop | login_button: action: 'follow' }}
              {% # theme-check-enable %}
            </div>
          {%- endif -%}
          {%- if section.settings.show_payment_icons -%}
            {%- render 'payment-icons', section: section -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</footer>
