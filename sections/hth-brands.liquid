{%- liquid
  capture anim
    render 'hth-anim', section_animation: section.settings.animations
  endcapture
-%}
<section
  id="m-section--{{ section.id }}"
  class="m-section hth-section hth-brands hth-brands--{{ section.settings.style }} m-gradient m-color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --hth-cols: {{ section.settings.columns }};"
  data-section-id="{{ section.id }}"
>
  <div class="{{ section.settings.container }} m-section-py">
    {%- render 'hth-section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      alignment: section.settings.header_alignment,
      heading_size: section.settings.heading_size,
      anim: anim
    -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="hth-brands__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = 'span'
            if block.settings.link != blank
              assign tag = 'a'
            endif
          -%}
          <li
            class="hth-brands__item{{ anim }}"
            {% if anim != blank %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <{{ tag }}
              class="hth-brands__inner"
              {% if tag == 'a' %}
                href="{{ block.settings.link }}"
              {% endif %}
            >
              {%- if block.settings.logo != blank -%}
                {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '200px', alt: block.settings.name, class: 'hth-brands__logo' }}
              {%- else -%}
                <span class="hth-brands__name">{{ block.settings.name | escape }}</span>
              {%- endif -%}
            </{{ tag }}>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Brands we stock",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Trusted names"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Brands we stock"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": ""
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h2",
          "label": "Extra large"
        }
      ],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "Brands"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "grid",
          "label": "Bordered grid"
        },
        {
          "value": "plain",
          "label": "Plain"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Brands per row (desktop)",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Width",
      "options": [
        {
          "value": "container",
          "label": "Boxed"
        },
        {
          "value": "container-fluid",
          "label": "Wide"
        },
        {
          "value": "container-full",
          "label": "Full width"
        }
      ],
      "default": "container"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Animation",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme setting"
        },
        {
          "value": "fade-in",
          "label": "Fade in"
        },
        {
          "value": "fade-in-up",
          "label": "Fade in up"
        },
        {
          "value": "fade-in-left",
          "label": "Fade in left"
        },
        {
          "value": "fade-in-right",
          "label": "Fade in right"
        }
      ],
      "default": "inherit"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "default": "Brand"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Optional. The brand name is shown as text when no logo is added."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Brands we stock",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "name": "Ninja"
          }
        },
        {
          "type": "brand",
          "settings": {
            "name": "Shark"
          }
        },
        {
          "type": "brand",
          "settings": {
            "name": "De'Longhi"
          }
        },
        {
          "type": "brand",
          "settings": {
            "name": "Hisense"
          }
        },
        {
          "type": "brand",
          "settings": {
            "name": "Kamado Joe"
          }
        },
        {
          "type": "brand",
          "settings": {
            "name": "Gozney"
          }
        }
      ]
    }
  ]
}
{% endschema %}
