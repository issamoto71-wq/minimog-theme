{%- liquid
  capture anim
    render 'hth-anim', section_animation: section.settings.animations
  endcapture
-%}
<section
  id="m-section--{{ section.id }}"
  class="m-section hth-section hth-promo hth-promo--{{ section.settings.layout }} m-gradient m-color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --hth-gap: {{ section.settings.gap }}px; --hth-min-height: {{ section.settings.min_height }}px;"
  data-section-id="{{ section.id }}"
>
  <div class="{{ section.settings.container }} m-section-py">
    {%- render 'hth-section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      alignment: section.settings.header_alignment,
      heading_size: section.settings.heading_size,
      anim: anim
    -%}
    {%- if section.blocks.size > 0 -%}
      <div class="hth-promo__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = 'div'
            if block.settings.link != blank
              assign tag = 'a'
            endif
          -%}
          <{{ tag }}
            class="hth-promo__tile hth-promo__tile--{{ block.settings.text_color }} m-gradient m-color-{{ block.settings.color_scheme }}{{ anim }}"
            {% if tag == 'a' %}
              href="{{ block.settings.link }}"
            {% endif %}
            {% if anim != blank %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              <span class="hth-promo__media">
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 1024px) 50vw, 100vw', alt: '', class: 'hth-promo__img' }}
              </span>
            {%- endif -%}
            <span class="hth-promo__body">
              {%- if block.settings.eyebrow != blank -%}
                <span class="hth-promo__eyebrow">{{ block.settings.eyebrow | escape }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <span class="hth-promo__title">{{ block.settings.title }}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <span class="hth-promo__text">{{ block.settings.text | escape }}</span>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <span class="hth-promo__cta">
                  {{- block.settings.button_label | escape -}}
                  {%- render 'hth-icon', name: 'arrow-right', size: 18, stroke: 2 -%}
                </span>
              {%- endif -%}
            </span>
          </{{ tag }}>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Promo tiles",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": ""
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": ""
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h2",
          "label": "Extra large"
        }
      ],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Arrangement",
      "options": [
        {
          "value": "large-left",
          "label": "One large + stacked tiles (large on left)"
        },
        {
          "value": "large-right",
          "label": "One large + stacked tiles (large on right)"
        },
        {
          "value": "two-up",
          "label": "Two equal tiles"
        },
        {
          "value": "three-up",
          "label": "Three equal tiles"
        }
      ],
      "default": "large-left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Tile height",
      "min": 200,
      "max": 600,
      "step": 20,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Width",
      "options": [
        {
          "value": "container",
          "label": "Boxed"
        },
        {
          "value": "container-fluid",
          "label": "Wide"
        },
        {
          "value": "container-full",
          "label": "Full width"
        }
      ],
      "default": "container"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Animation",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme setting"
        },
        {
          "value": "fade-in",
          "label": "Fade in"
        },
        {
          "value": "fade-in-up",
          "label": "Fade in up"
        },
        {
          "value": "fade-in-left",
          "label": "Fade in left"
        },
        {
          "value": "fade-in-right",
          "label": "Fade in right"
        }
      ],
      "default": "inherit"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Tile colour (when no image)",
          "default": "dark"
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Text colour",
          "options": [
            {
              "value": "light",
              "label": "Light"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ],
          "default": "light"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small label",
          "default": "Offer"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Heading",
          "default": "Promo heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": ""
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Promo tiles",
      "blocks": [
        {
          "type": "promo",
          "settings": {
            "eyebrow": "Summer BBQ",
            "title": "Fire up the garden",
            "text": "Kamado, charcoal and pellet BBQs ready to collect.",
            "button_label": "Shop BBQs"
          }
        },
        {
          "type": "promo",
          "settings": {
            "eyebrow": "Kitchen",
            "title": "Air fryers from £89",
            "button_label": "Shop now",
            "color_scheme": "ember"
          }
        },
        {
          "type": "promo",
          "settings": {
            "eyebrow": "Home",
            "title": "Fresh, clean air",
            "button_label": "Shop now",
            "color_scheme": "sage",
            "text_color": "dark"
          }
        }
      ]
    }
  ]
}
{% endschema %}
