{%- liquid
  capture anim
    render 'hth-anim', section_animation: section.settings.animations
  endcapture
  assign image_alt = section.settings.heading | strip_html
-%}
<section
  id="m-section--{{ section.id }}"
  class="m-section hth-section hth-why hth-why--{{ section.settings.layout }} m-gradient m-color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-section-id="{{ section.id }}"
>
  <div class="{{ section.settings.container }} m-section-py">
    <div class="hth-why__grid">
      <div class="hth-why__media{{ anim }}">
        <div class="hth-why__frame">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500, 800, 1100', sizes: '(min-width: 1024px) 45vw, 100vw', alt: image_alt, class: 'hth-why__img' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hth-why__img hth-placeholder' }}
          {%- endif -%}
        </div>
        {%- if section.settings.image_2 != blank -%}
          <div class="hth-why__frame hth-why__frame--small">
            {{ section.settings.image_2 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '280px', alt: '', class: 'hth-why__img' }}
          </div>
        {%- endif -%}
        {%- if section.settings.badge_value != blank -%}
          <div class="hth-why__badge">
            <strong class="hth-why__badge-value">{{ section.settings.badge_value | escape }}</strong>
            {%- if section.settings.badge_label != blank -%}
              <span class="hth-why__badge-label">{{ section.settings.badge_label | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      <div class="hth-why__content">
        {%- render 'hth-section-header',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          text: section.settings.text,
          alignment: 'left',
          heading_size: section.settings.heading_size,
          anim: anim
        -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="hth-why__list" role="list">
            {%- for block in section.blocks -%}
              <li
                class="hth-why__item{{ anim }}"
                {% if anim != blank %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <span class="hth-why__icon">{%- render 'hth-icon', name: block.settings.icon, size: 26 -%}</span>
                <span class="hth-why__text">
                  {%- if block.settings.title != blank -%}
                    <strong class="hth-why__title">{{ block.settings.title | escape }}</strong>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <span class="hth-why__desc">{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.button_label != blank or section.settings.second_button_label != blank -%}
          <div class="hth-btn-row{{ anim }}">
            {%- if section.settings.button_label != blank -%}
              <a class="m-button {{ section.settings.button_style }}" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.second_button_label != blank -%}
              <a class="m-button {{ section.settings.second_button_style }}" href="{{ section.settings.second_button_link | default: '#' }}">{{ section.settings.second_button_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
