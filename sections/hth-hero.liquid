{%- liquid
  capture anim
    render 'hth-anim', section_animation: section.settings.animations
  endcapture
  assign image_alt = section.settings.heading | strip_html
  assign is_background = false
  if section.settings.style == 'background'
    assign is_background = true
  endif
-%}
<section
  id="m-section--{{ section.id }}"
  class="m-section hth-section hth-homehero hth-homehero--{{ section.settings.style }} hth-homehero--{{ section.settings.layout }} m-gradient m-color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --hth-min-height: {{ section.settings.min_height }}px; --hth-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  data-section-id="{{ section.id }}"
>
  {%- if is_background and section.settings.image != blank -%}
    <div class="hth-homehero__bg">
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: '', class: 'hth-homehero__bg-img' }}
    </div>
  {%- endif -%}
  <div class="{{ section.settings.container }} m-section-py">
    <div class="hth-homehero__grid">
      <div class="hth-homehero__content{{ anim }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hth-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hth-heading h1">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="hth-lead">{{ section.settings.text | escape | newline_to_br }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank or section.settings.second_button_label != blank -%}
          <div class="hth-btn-row">
            {%- if section.settings.button_label != blank -%}
              <a class="m-button {{ section.settings.button_style }} m-button--large" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.second_button_label != blank -%}
              <a class="m-button {{ section.settings.second_button_style }} m-button--large" href="{{ section.settings.second_button_link | default: '#' }}">{{ section.settings.second_button_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="hth-homehero__bullets" role="list">
            {%- for block in section.blocks -%}
              <li class="hth-homehero__bullet" {{ block.shopify_attributes }}>
                {%- render 'hth-icon', name: block.settings.icon, size: 22 -%}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- unless is_background -%}
        <div class="hth-homehero__visual{{ anim }}">
          <div class="hth-homehero__frame">
            {%- if section.settings.image != blank -%}
              {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 800, 1200', sizes: '(min-width: 1024px) 48vw, 100vw', alt: image_alt, class: 'hth-homehero__img' }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'hth-homehero__img hth-placeholder' }}
            {%- endif -%}
          </div>
          {%- if section.settings.image_2 != blank -%}
            <div class="hth-homehero__frame hth-homehero__frame--small">
              {{ section.settings.image_2 | image_url: width: 600 | image_tag: loading: 'eager', widths: '300, 450, 600', sizes: '260px', alt: '', class: 'hth-homehero__img' }}
            </div>
          {%- endif -%}
          {%- if section.settings.float_title != blank -%}
            <div class="hth-homehero__float">
              <span class="hth-homehero__float-icon">{%- render 'hth-icon', name: section.settings.float_icon, size: 26 -%}</span>
              <span class="hth-homehero__float-text">
                <strong>{{ section.settings.float_title | escape }}</strong>
                {%- if section.settings.float_text != blank -%}
                  <span>{{ section.settings.float_text | escape }}</span>
                {%- endif -%}
              </span>
            </div>
          {%- endif -%}
        </div>
      {%- endunless -%}
    </div>
  </div>
</section>
