{
  "type": "footer",
  "name": "Footer",
  "sections": {
    "footer": {
      "type": "hth-footer",
      "blocks": {
        "perk_1": {
          "type": "perk",
          "settings": {
            "icon": "store",
            "title": "Free Click & Collect",
            "text": "Ready in 2 hours"
          }
        },
        "perk_2": {
          "type": "perk",
          "settings": {
            "icon": "truck",
            "title": "Free delivery over £150",
            "text": "Installation available"
          }
        },
        "perk_3": {
          "type": "perk",
          "settings": {
            "icon": "tag",
            "title": "Price match promise",
            "text": "Found it cheaper? Ask us"
          }
        },
        "perk_4": {
          "type": "perk",
          "settings": {
            "icon": "users",
            "title": "Expert advice",
            "text": "In store and by phone"
          }
        },
        "about_1": {
          "type": "about",
          "settings": {
            "logo_width": 180,
            "text": "<p>Your local kitchen, outdoor and home specialists. Come and see our full range in store, or reserve online and collect.</p>",
            "show_contact": true,
            "show_social": true,
            "width": "4"
          }
        },
        "menu_shop": {
          "type": "menu",
          "settings": {
            "heading": "Shop",
            "menu": "main-menu",
            "width": "2"
          }
        },
        "menu_help": {
          "type": "menu",
          "settings": {
            "heading": "Help & info",
            "menu": "footer",
            "width": "2"
          }
        },
        "store_1": {
          "type": "store",
          "settings": {
            "heading": "Visit the store",
            "show_address": true,
            "show_hours": true,
            "button_label": "Get directions",
            "width": "4"
          }
        },
        "newsletter_1": {
          "type": "newsletter",
          "settings": {
            "heading": "Offers & news",
            "text": "Sign up for deals, new arrivals and BBQ-season tips.",
            "placeholder": "Your email address",
            "button_label": "Sign up",
            "width": "12"
          }
        }
      },
      "block_order": [
        "perk_1",
        "perk_2",
        "perk_3",
        "perk_4",
        "about_1",
        "menu_shop",
        "menu_help",
        "store_1",
        "newsletter_1"
      ],
      "settings": {
        "color_scheme": "footer",
        "perks_color_scheme": "dark",
        "bottom_color_scheme": "footer",
        "container": "container",
        "copyright": "&copy; {year} {store}. All rights reserved.",
        "footer_bottom_menu": "",
        "show_payment_icons": true,
        "payment_icons_width": 300,
        "show_country_selector": false,
        "show_currency_selector": false,
        "show_language_selector": false,
        "enable_follow_on_shop": true
      }
    },
    "mobile-sticky-bar": {
      "type": "mobile-sticky-bar",
      "settings": {
        "show_mobile_sticky": true,
        "show_home_icon": true,
        "show_collection_icon": true,
        "show_cart_icon": true,
        "show_search_icon": true,
        "show_account_icon": false,
        "show_wishlist_icon": false
      }
    }
  },
  "order": [
    "footer",
    "mobile-sticky-bar"
  ]
}
