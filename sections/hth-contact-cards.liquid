{%- liquid
  capture anim
    render 'hth-anim', section_animation: section.settings.animations
  endcapture
-%}
<section
  id="m-section--{{ section.id }}"
  class="m-section hth-section hth-contact m-gradient m-color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --hth-cols: {{ section.settings.columns }};"
  data-section-id="{{ section.id }}"
>
  <div class="{{ section.settings.container }} m-section-py">
    {%- render 'hth-section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      alignment: section.settings.header_alignment,
      heading_size: section.settings.heading_size,
      anim: anim
    -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="hth-contact__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_icon = block.settings.icon
            assign card_title = block.settings.title
            assign card_link = ''
            assign card_link_label = block.settings.link_label
            case block.type
              when 'phone'
                assign card_icon = 'phone'
                assign card_title = card_title | default: 'Call us'
                assign card_text = settings.contact_phone_number
                assign card_link = 'tel:' | append: settings.contact_phone_number | replace: ' ', ''
              when 'email'
                assign card_icon = 'mail'
                assign card_title = card_title | default: 'Email us'
                assign card_text = settings.contact_email
                assign card_link = 'mailto:' | append: settings.contact_email
              when 'address'
                assign card_icon = 'pin'
                assign card_title = card_title | default: 'Visit the store'
                assign card_text = settings.store_address
                assign card_link = settings.store_directions_url
                assign card_link_label = card_link_label | default: 'Get directions'
              when 'hours'
                assign card_icon = 'clock'
                assign card_title = card_title | default: 'Opening hours'
                assign card_text = settings.store_opening_hours
              else
                assign card_text = block.settings.text
                assign card_link = block.settings.link
            endcase
            assign tag = 'div'
            if card_link != blank
              assign tag = 'a'
            endif
          -%}
          <li
            class="hth-contact__item{{ anim }}"
            {% if anim != blank %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <{{ tag }}
              class="hth-contact__inner"
              {% if tag == 'a' %}
                href="{{ card_link }}"
              {% endif %}
            >
              <span class="hth-contact__icon">{%- render 'hth-icon', name: card_icon, size: 28 -%}</span>
              <span class="hth-contact__title">{{ card_title | escape }}</span>
              {%- if block.type == 'hours' -%}
                {%- assign hours_lines = card_text | newline_to_br | split: '<br />' -%}
                <span class="hth-contact__hours">
                  {%- for line in hours_lines -%}
                    {%- assign parts = line | strip | split: '|' -%}
                    {%- if parts.size > 1 -%}
                      <span class="hth-contact__hours-row"><span>{{ parts[0] | strip | escape }}</span><span>{{ parts[1] | strip | escape }}</span></span>
                    {%- endif -%}
                  {%- endfor -%}
                </span>
              {%- elsif card_text != blank -%}
                <span class="hth-contact__text">{{ card_text | escape | newline_to_br }}</span>
              {%- endif -%}
              {%- if card_link_label != blank and card_link != blank -%}
                <span class="hth-link">
                  {{- card_link_label | escape -}}
                  {%- render 'hth-icon', name: 'arrow-right', size: 16, stroke: 2 -%}
                </span>
              {%- endif -%}
            </{{ tag }}>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
