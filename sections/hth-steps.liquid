{%- liquid
  capture anim
    render 'hth-anim', section_animation: section.settings.animations
  endcapture
-%}
<section
  id="m-section--{{ section.id }}"
  class="m-section hth-section hth-steps m-gradient m-color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --hth-cols: {{ section.blocks.size }};"
  data-section-id="{{ section.id }}"
>
  <div class="{{ section.settings.container }} m-section-py">
    {%- render 'hth-section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      alignment: section.settings.header_alignment,
      heading_size: section.settings.heading_size,
      anim: anim
    -%}
    {%- if section.blocks.size > 0 -%}
      <ol class="hth-steps__list" role="list">
        {%- for block in section.blocks -%}
          <li
            class="hth-steps__item{{ anim }}"
            {% if anim != blank %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <span class="hth-steps__number">{{ forloop.index }}</span>
            <span class="hth-steps__icon">{%- render 'hth-icon', name: block.settings.icon, size: 28 -%}</span>
            {%- if block.settings.title != blank -%}
              <h3 class="hth-steps__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="hth-steps__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="hth-btn-row hth-btn-row--center{{ anim }}">
        <a class="m-button {{ section.settings.button_style }}" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Step by step",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "How it works"
